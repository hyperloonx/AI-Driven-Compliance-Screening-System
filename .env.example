# Copy this file to .env and fill in your values

# ── Agent Mode ───────────────────────────────────────────────
# RULE_BASED: deterministic rule-based screening (default, no API key needed)
# AI_MODE: uses OpenAI for intelligent compliance decisions
AGENT_MODE=RULE_BASED

# ── OpenAI (only required for AI_MODE) ───────────────────────
OPENAI_API_KEY=

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (used in Docker)
DATABASE_URL=postgresql+asyncpg://compliance_user:compliance_pass@localhost:5432/compliance_db
# SQLite (local development fallback — default if DATABASE_URL not set)
# DATABASE_URL=sqlite+aiosqlite:///./compliance.db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Reports ──────────────────────────────────────────────────
REPORTS_DIR=reports

# ── Debug ────────────────────────────────────────────────────
DEBUG=false
